/* Generated by remappr — ZMK keymap for Mock Corne.
 * Keymap layers, behaviors, combos, macros and tap-dances only.
 * Physical layout + matrix-transform live in the .overlay; board
 * hardware (kscan, pinctrl, LED drivers, …) is NOT generated — see
 * the "NOT GENERATED" checklist in the .overlay. */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        lock_screen: lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LEFT_GUI>, <&macro_tap &kp L>, <&macro_release &kp LEFT_GUI>;
        };
    };

    behaviors {
        esc_grave: esc_grave {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESCAPE>, <&kp GRAVE>;
        };
    };

    behaviors {
        mm_comma_semi: mm_comma_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMICOLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_bspc_del: mm_bspc_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LGUI)>;
        };
    };

    behaviors {
        ht_home_row: ht_home_row {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };
        ht_layer_tap: ht_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <180>;
            require-prior-idle-ms = <100>;
            retro-tap;
        };
    };

    behaviors {
        sr_2_0: sr_2_0 {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESCAPE>;
            layers = <0>;
        };
        combo_tab {
            key-positions = <5 6>;
            bindings = <&kp TAB>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        cond_0 {
            if-layers = <1>;
            then-layer = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layer_base {
            display-name = "base";
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T &mt LGUI A
                &mt LALT S &mt LCTRL D &mt LSHFT F &kp G &kp Z &kp X
                &kp C &kp V &kp B &kp ESCAPE &lt 2 SPACE &kp TAB
                &kp Y &kp U &kp I &kp O &kp P &kp H
                &mt LSHFT J &mt LCTRL K &mt LALT L &mt LGUI SEMICOLON &kp N &kp M
                &kp COMMA &kp PERIOD &kp SLASH &kp RETURN &lt 1 BACKSPACE &kp DELETE
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
        layer_lower {
            display-name = "lower";
            bindings = <
                &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &kp NUMBER_4 &kp NUMBER_5 &kp LEFT_ARROW
                &kp DOWN_ARROW &kp UP_ARROW &kp RIGHT_ARROW &mo 2 &kp C &kp V
                &caps_word &esc_grave &kp GRAVE &trans &trans &trans
                &kp NUMBER_6 &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9 &kp NUMBER_0 &kp PAGE_UP
                &kp PAGE_DOWN &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };
        layer_raise {
            display-name = "raise";
            bindings = <
                &out OUT_USB &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_CLR &rgb_ug RGB_TOG &rgb_ug RGB_BRI
                &rgb_ug RGB_BRD &none &bootloader &sys_reset &none &lock_screen
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&sr_2_0>;
        };
    };
};
